# Containastore — environment variables
# Copy to .env.local for local development. Never commit real values.

# ---- Public site ----------------------------------------------------------
# Canonical origin, no trailing slash. Used for canonical URLs, sitemap, OG tags.
# www is canonical here — see DISCREPANCIES.md "Canonical host".
NEXT_PUBLIC_SITE_URL=https://www.containastore.co.uk

# Canonical host (no protocol, WITH www). Used by next.config.mjs to 301 the bare
# apex host into this one. Must start with "www." — the apex is derived from it.
CANONICAL_HOST=www.containastore.co.uk

# Public-facing contact email shown on the site.
CONTACT_EMAIL=hello@containastore.co.uk

# ---- Enquiry form -------------------------------------------------------------
# Where the enquiry form POSTs. Leave BLANK to run the honest fallback
# (validate input, then show phone + email instead of pretending to send).
# Supported: a full URL to a form-forwarding service (e.g. Formspree, Web3Forms),
# or your own endpoint that accepts JSON { name, email, phone, size, startDate, message }.
FORM_ENDPOINT=

# Address the enquiry is delivered to. Falls back to CONTACT_EMAIL if unset.
FORM_RECIPIENT_EMAIL=hello@containastore.co.uk

# Optional shared secret forwarded as `x-form-token` to your endpoint.
FORM_TOKEN=

# ---- Admin -----------------------------------------------------------------
# Password for the /admin area. If unset, /admin is disabled entirely.
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie. Any long random string.
ADMIN_SESSION_SECRET=
